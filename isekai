import { useState, useEffect, useRef } from "react";

const SYSTEM_PROMPT = `あなたは異世界ファンタジーRPGのゲームマスターです。
プレイヤーは異世界に召喚された勇者です。

ルール：
- 毎回の返答は必ずJSON形式のみで返してください（マークダウンや説明文は一切不要）
- 以下のJSON構造を厳守してください：
{
  "narrative": "物語の描写（200字以内、臨場感ある文章）",
  "situation": "現在の状況の簡潔な説明（50字以内）",
  "choices": ["選択肢1", "選択肢2", "選択肢3"],
  "hpChange": 0,
  "mpChange": 0,
  "goldChange": 0,
  "itemGained": null,
  "battleResult": null
}

- choices は必ず3つ提供する
- hpChange/mpChange/goldChange は整数（マイナス可）
- itemGained は入手したアイテム名（なければnull）
- battleResult は "victory"/"defeat"/null
- 戦闘、謎解き、NPC交流、宝探しなど多彩なイベントを用意する
- プレイヤーのHPが0になったらgame overの描写をする
- 世界観：魔法と剣の中世ファンタジー。竜、魔王、エルフ、ドワーフが存在する`;

const INITIAL_STATE = {
  hp: 100, maxHp: 100,
  mp: 50, maxMp: 50,
  gold: 10,
  level: 1,
  xp: 0,
  items: ["回復薬×1"],
  playerName: "",
  gameStarted: false,
  gameOver: false,
  log: [],
  narrative: "",
  situation: "冒険の始まり",
  choices: [],
  loading: false,
  history: [],
};

const CLASSES = ["⚔️ 勇者", "🔮 魔法使い", "🗡️ 盗賊", "🛡️ 騎士"];

export default function IsekaiRPG() {
  const [state, setState] = useState(INITIAL_STATE);
  const [nameInput, setNameInput] = useState("");
  const [selectedClass, setSelectedClass] = useState(CLASSES[0]);
  const logRef = useRef(null);

  useEffect(() => {
    if (logRef.current) {
      logRef.current.scrollTop = logRef.current.scrollHeight;
    }
  }, [state.log]);

  async function startGame() {
    if (!nameInput.trim()) return;
    setState(s => ({ ...s, loading: true, playerName: nameInput, gameStarted: true }));
    await callAI(`ゲーム開始。プレイヤー名：${nameInput}、職業：${selectedClass}。異世界に召喚されたオープニングシーンから始めてください。`, [], nameInput, selectedClass);
  }

  async function makeChoice(choice) {
    if (state.loading || state.gameOver) return;
    const newHistory = [...state.history, 
      { role: "assistant", content: JSON.stringify({ narrative: state.narrative, situation: state.situation, choices: state.choices }) },
      { role: "user", content: `プレイヤーの選択：「${choice}」` }
    ];
    setState(s => ({ ...s, loading: true, history: newHistory }));
    await callAI(`プレイヤーの選択：「${choice}」`, newHistory, state.playerName, selectedClass);
  }

  async function callAI(userMessage, history, playerName, playerClass) {
    try {
      const messages = history.length > 0
        ? [...history]
        : [{ role: "user", content: userMessage }];
      
      if (history.length === 0) {
        messages[0].content = userMessage;
      }

      const response = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          model: "claude-sonnet-4-20250514",
          max_tokens: 1000,
          system: SYSTEM_PROMPT + `\nプレイヤー情報：名前=${playerName}、職業=${playerClass}`,
          messages: messages.length > 0 ? messages : [{ role: "user", content: userMessage }],
        })
      });
      const data = await response.json();
      const text = data.content?.map(i => i.text || "").join("") || "{}";
      
      let parsed;
      try {
        const clean = text.replace(/```json|```/g, "").trim();
        parsed = JSON.parse(clean);
      } catch {
        parsed = {
          narrative: "冒険は続く…（エラーが発生しました）",
          situation: "不明",
          choices: ["前に進む", "周囲を探索する", "休息する"],
          hpChange: 0, mpChange: 0, goldChange: 0,
          itemGained: null, battleResult: null
        };
      }

      setState(s => {
        const newHp = Math.min(s.maxHp, Math.max(0, s.hp + (parsed.hpChange || 0)));
        const newMp = Math.min(s.maxMp, Math.max(0, s.mp + (parsed.mpChange || 0)));
        const newGold = Math.max(0, s.gold + (parsed.goldChange || 0));
        const newItems = parsed.itemGained ? [...s.items, parsed.itemGained] : s.items;
        const isGameOver = newHp <= 0;
        
        const logEntry = {
          narrative: parsed.narrative,
          hpChange: parsed.hpChange,
          mpChange: parsed.mpChange,
          goldChange: parsed.goldChange,
          itemGained: parsed.itemGained,
          battleResult: parsed.battleResult,
        };

        return {
          ...s,
          hp: newHp, mp: newMp, gold: newGold,
          items: newItems,
          narrative: parsed.narrative || "",
          situation: parsed.situation || "",
          choices: isGameOver ? [] : (parsed.choices || []),
          log: [...s.log, logEntry],
          loading: false,
          gameOver: isGameOver,
          history: [
            ...s.history,
            { role: "assistant", content: text }
          ],
        };
      });
    } catch (err) {
      setState(s => ({ ...s, loading: false }));
    }
  }

  function resetGame() {
    setState(INITIAL_STATE);
    setNameInput("");
  }

  const hpPercent = (state.hp / state.maxHp) * 100;
  const mpPercent = (state.mp / state.maxMp) * 100;

  if (!state.gameStarted) {
    return (
      <div style={styles.root}>
        <div style={styles.titleScreen}>
          <div style={styles.titleGlow}>⚔️</div>
          <h1 style={styles.title}>異世界転生RPG</h1>
          <p style={styles.subtitle}>〜 勇者よ、世界を救え 〜</p>
          <div style={styles.setupCard}>
            <label style={styles.label}>勇者の名前</label>
            <input
              style={styles.input}
              value={nameInput}
              onChange={e => setNameInput(e.target.value)}
              placeholder="名前を入力..."
              onKeyDown={e => e.key === "Enter" && startGame()}
              maxLength={20}
            />
            <label style={styles.label}>職業を選択</label>
            <div style={styles.classGrid}>
              {CLASSES.map(c => (
                <button
                  key={c}
                  style={{ ...styles.classBtn, ...(selectedClass === c ? styles.classBtnActive : {}) }}
                  onClick={() => setSelectedClass(c)}
                >
                  {c}
                </button>
              ))}
            </div>
            <button
              style={{ ...styles.startBtn, ...(nameInput.trim() ? {} : styles.startBtnDisabled) }}
              onClick={startGame}
              disabled={!nameInput.trim()}
            >
              冒険を始める
            </button>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div style={styles.root}>
      <div style={styles.gameLayout}>
        {/* サイドバー：ステータス */}
        <div style={styles.sidebar}>
          <div style={styles.statusCard}>
            <div style={styles.playerHeader}>
              <span style={styles.playerAvatar}>🧙</span>
              <div>
                <div style={styles.playerName}>{state.playerName}</div>
                <div style={styles.playerClass}>{selectedClass} Lv.{state.level}</div>
              </div>
            </div>
            
            <div style={styles.statRow}>
              <span style={styles.statLabel}>HP</span>
              <div style={styles.barBg}>
                <div style={{ ...styles.barFill, width: `${hpPercent}%`, background: hpPercent > 50 ? "#4ade80" : hpPercent > 25 ? "#facc15" : "#f87171" }} />
              </div>
              <span style={styles.statVal}>{state.hp}/{state.maxHp}</span>
            </div>
            
            <div style={styles.statRow}>
              <span style={styles.statLabel}>MP</span>
              <div style={styles.barBg}>
                <div style={{ ...styles.barFill, width: `${mpPercent}%`, background: "#818cf8" }} />
              </div>
              <span style={styles.statVal}>{state.mp}/{state.maxMp}</span>
            </div>

            <div style={styles.goldRow}>
              <span>💰 {state.gold} G</span>
            </div>

            <div style={styles.itemsSection}>
              <div style={styles.itemsTitle}>🎒 アイテム</div>
              {state.items.length === 0
                ? <div style={styles.noItems}>なし</div>
                : state.items.map((item, i) => (
                    <div key={i} style={styles.itemTag}>{item}</div>
                  ))
              }
            </div>
          </div>

          <button style={styles.resetBtn} onClick={resetGame}>🔄 最初から</button>
        </div>

        {/* メインエリア */}
        <div style={styles.main}>
          <div style={styles.situationBar}>
            📍 {state.situation}
          </div>

          {/* ログ */}
          <div style={styles.logArea} ref={logRef}>
            {state.log.map((entry, i) => (
              <div key={i} style={styles.logEntry}>
                <p style={styles.logNarrative}>{entry.narrative}</p>
                <div style={styles.logTags}>
                  {entry.hpChange !== 0 && (
                    <span style={{ ...styles.tag, color: entry.hpChange > 0 ? "#4ade80" : "#f87171" }}>
                      HP {entry.hpChange > 0 ? "+" : ""}{entry.hpChange}
                    </span>
                  )}
                  {entry.mpChange !== 0 && (
                    <span style={{ ...styles.tag, color: "#818cf8" }}>
                      MP {entry.mpChange > 0 ? "+" : ""}{entry.mpChange}
                    </span>
                  )}
                  {entry.goldChange !== 0 && (
                    <span style={{ ...styles.tag, color: "#facc15" }}>
                      💰 {entry.goldChange > 0 ? "+" : ""}{entry.goldChange}G
                    </span>
                  )}
                  {entry.itemGained && (
                    <span style={{ ...styles.tag, color: "#fb923c" }}>✨ {entry.itemGained} 入手！</span>
                  )}
                  {entry.battleResult === "victory" && (
                    <span style={{ ...styles.tag, color: "#fbbf24" }}>⚔️ 勝利！</span>
                  )}
                  {entry.battleResult === "defeat" && (
                    <span style={{ ...styles.tag, color: "#f87171" }}>💀 敗北</span>
                  )}
                </div>
              </div>
            ))}
            {state.loading && (
              <div style={styles.loadingDots}>
                <span style={styles.dot1}>●</span>
                <span style={styles.dot2}>●</span>
                <span style={styles.dot3}>●</span>
              </div>
            )}
          </div>

          {/* 選択肢 or Game Over */}
          {state.gameOver ? (
            <div style={styles.gameOverBox}>
              <div style={styles.gameOverTitle}>💀 GAME OVER</div>
              <p style={styles.gameOverText}>{state.playerName}の冒険はここで終わった…</p>
              <button style={styles.retryBtn} onClick={resetGame}>もう一度挑戦する</button>
            </div>
          ) : (
            <div style={styles.choicesArea}>
              {state.choices.map((choice, i) => (
                <button
                  key={i}
                  style={{ ...styles.choiceBtn, ...(state.loading ? styles.choiceBtnDisabled : {}) }}
                  onClick={() => makeChoice(choice)}
                  disabled={state.loading}
                >
                  <span style={styles.choiceNum}>{i + 1}</span>
                  {choice}
                </button>
              ))}
            </div>
          )}
        </div>
      </div>

      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;600;700&family=Cinzel:wght@700&display=swap');
        @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
        .d1{animation:pulse 1s ease-in-out 0s infinite}
        .d2{animation:pulse 1s ease-in-out 0.2s infinite}
        .d3{animation:pulse 1s ease-in-out 0.4s infinite}
      `}</style>
    </div>
  );
}

